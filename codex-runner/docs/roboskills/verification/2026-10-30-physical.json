      "reply": "```python\nshow(bot.observe())\nstart = bot.status()\nprint(\"Starting measured state:\", start)\n\ndef verify(state, target_z):\n    if state.get(\"ended\") or state.get(\"stop\") or state.get(\"Stop\"):\n        raise RuntimeError(\"Stopped; no further motion.\")\n    c = state[\"coordinates\"]\n    for arm in (\"left\", \"right\"):\n        if abs(c[f\"{arm}_z\"] - target_z[arm]) > 0.003:\n            raise RuntimeError(f\"{arm}: measured height outside 3 mm tolerance.\")\n        for axis in (\"x\", \"y\"):\n            key = f\"{arm}_{axis}\"\n            if abs(c[key] - origin[key]) > 0.003:\n                raise RuntimeError(f\"{arm}: unexpected lateral motion.\")\n        key = f\"{arm}_gripper\"\n        if abs(c[key] - origin[key]) > 0.01:\n            raise RuntimeError(f\"{arm}: gripper changed.\")\n\ntry:\n    if start.get(\"ended\") or start.get(\"stop\") or start.get(\"Stop\"):\n        raise RuntimeError(\"Stop active.\")\n    origin = dict(start[\"coordinates\"])\n    raised = {arm: origin[f\"{arm}_z\"] + 0.020 for arm in (\"left\", \"right\")}\n    print(\"Lift completion:\", bot.move_to(\n        left_z=raised[\"left\"], right_z=raised[\"right\"]))\n    lifted = bot.status()\n    print(\"Measured lifted state:\", lifted)\n    verify(lifted, raised)\n\n    bot.wait(1.0)\n    held = bot.status()\n    print(\"Measured held state:\", held)\n    verify(held, raised)\n\n    print(\"Return completion:\", bot.move_to(\n        left_z=origin[\"left_z\"], right_z=origin[\"right_z\"]))\n    returned = bot.status()\n    print(\"Measured returned state:\", returned)\n    verify(returned, {arm: origin[f\"{arm}_z\"] for arm in (\"left\", \"right\")})\n    print(\"Lift and return verified within 3 mm; grippers unchanged within 0.01.\")\nexcept Exception as exc:\n    print(\"Ending without further motion:\", exc)\nfinally:\n    finish()\n```",
